{
    "elements": [
        {
            "type": "Label",
            "caption": "Switches the decoration lights on at dusk or sunset within a time window, as long as someone is at home, and off again at the end of the window, when nobody is present or when it stays bright. Times, limits and switches are variables of the instance and can be changed in the visualization."
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Instance active"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Lights",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "Lights",
                    "caption": "Lights to switch (switch or dimmer variables with action)",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "320px",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable",
                                "requiredAction": 1,
                                "validVariableTypes": [0, 1, 2]
                            }
                        },
                        {
                            "caption": "Name in the tile (optional)",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Off at (HH:MM, optional)",
                            "name": "OffTime",
                            "width": "150px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox",
                                "validate": "^$|^([01]?[0-9]|2[0-3])[:.][0-5][0-9]$"
                            }
                        },
                        {
                            "caption": "Morning",
                            "name": "Morning",
                            "width": "90px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Dim level (dimmers only)",
                            "name": "Level",
                            "width": "170px",
                            "add": 100,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 255
                            }
                        }
                    ],
                    "values": []
                },
                {
                    "type": "Label",
                    "caption": "\"Off at\" switches a single light off earlier in the evening (e.g. the garden at 23:00 while the windows stay on). \"Morning\" decides whether the light takes part in the morning window. Dimmers are switched on with the dim level and off with 0."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Triggers",
            "expanded": false,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "BrightnessVariableID",
                    "caption": "Brightness sensor (lux, optional)",
                    "width": "600px"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "SensorMaxAge",
                            "caption": "Sensor counts as failed without new value after",
                            "suffix": "min",
                            "minimum": 5,
                            "maximum": 1440
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BrightCount",
                            "caption": "Permanently bright: values above the switch-off limit (of the last 5)",
                            "minimum": 1,
                            "maximum": 5
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "UseSunset",
                    "caption": "Also switch on at sunset (and while the sensor has failed)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectVariable",
                            "name": "SunsetVariableID",
                            "caption": "Sunset variable (empty = from Location)",
                            "width": "400px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "SunsetOffset",
                            "caption": "Offset",
                            "suffix": "min",
                            "minimum": -180,
                            "maximum": 180
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "SunsetInfo",
                    "caption": ""
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Times and season",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Switch-on and switch-off time are variables of the instance (visualization)."
                },
                {
                    "type": "Select",
                    "name": "WeekendMode",
                    "caption": "Own switch-off time for the evenings of",
                    "width": "400px",
                    "options": [
                        { "caption": "– none –", "value": 0 },
                        { "caption": "Friday and Saturday", "value": 1 },
                        { "caption": "Saturday and Sunday", "value": 2 },
                        { "caption": "Friday, Saturday and Sunday", "value": 3 }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "The weekend switch-off time is the instance variable \"Switch-off time at the weekend\"."
                },
                {
                    "type": "CheckBox",
                    "name": "MorningEnabled",
                    "caption": "Morning window: also switch on in the morning while it is dark"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectTime",
                            "name": "MorningFrom",
                            "caption": "From"
                        },
                        {
                            "type": "SelectTime",
                            "name": "MorningTo",
                            "caption": "Until at the latest"
                        },
                        {
                            "type": "CheckBox",
                            "name": "MorningUntilSunrise",
                            "caption": "End at sunrise"
                        },
                        {
                            "type": "CheckBox",
                            "name": "MorningWorkdays",
                            "caption": "Mondays to Fridays only"
                        }
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "SunriseVariableID",
                    "caption": "Sunrise variable (empty = from Location)",
                    "width": "400px"
                },
                {
                    "type": "Label",
                    "name": "SunriseInfo",
                    "caption": ""
                },
                {
                    "type": "Select",
                    "name": "SeasonMode",
                    "caption": "Season",
                    "width": "400px",
                    "options": [
                        { "caption": "All year round", "value": 0 },
                        { "caption": "Date range", "value": 1 },
                        { "caption": "From the 1st Advent", "value": 2 }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "SeasonStartDay",
                            "caption": "From day",
                            "minimum": 1,
                            "maximum": 31
                        },
                        {
                            "type": "Select",
                            "name": "SeasonStartMonth",
                            "caption": "Month",
                            "options": [
                                { "caption": "January", "value": 1 },
                                { "caption": "February", "value": 2 },
                                { "caption": "March", "value": 3 },
                                { "caption": "April", "value": 4 },
                                { "caption": "May", "value": 5 },
                                { "caption": "June", "value": 6 },
                                { "caption": "July", "value": 7 },
                                { "caption": "August", "value": 8 },
                                { "caption": "September", "value": 9 },
                                { "caption": "October", "value": 10 },
                                { "caption": "November", "value": 11 },
                                { "caption": "December", "value": 12 }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "SeasonEndDay",
                            "caption": "Until day",
                            "minimum": 1,
                            "maximum": 31
                        },
                        {
                            "type": "Select",
                            "name": "SeasonEndMonth",
                            "caption": "Month",
                            "options": [
                                { "caption": "January", "value": 1 },
                                { "caption": "February", "value": 2 },
                                { "caption": "March", "value": 3 },
                                { "caption": "April", "value": 4 },
                                { "caption": "May", "value": 5 },
                                { "caption": "June", "value": 6 },
                                { "caption": "July", "value": 7 },
                                { "caption": "August", "value": 8 },
                                { "caption": "September", "value": 9 },
                                { "caption": "October", "value": 10 },
                                { "caption": "November", "value": 11 },
                                { "caption": "December", "value": 12 }
                            ]
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "SeasonInfo",
                    "caption": ""
                },
                {
                    "type": "Label",
                    "caption": "With \"From the 1st Advent\" only the end date counts. Outside the season the lights are switched off once and the automatic rests."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Conditions",
            "expanded": false,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "PresenceVariableID",
                    "caption": "Presence (true = someone at home; empty = always present)",
                    "width": "600px"
                },
                {
                    "type": "SelectVariable",
                    "name": "VacationVariableID",
                    "caption": "Vacation (true = on vacation)",
                    "width": "600px"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "VacationMode",
                            "caption": "During vacation",
                            "width": "420px",
                            "options": [
                                { "caption": "Block switching on (switching off still works)", "value": 0 },
                                { "caption": "Simulate presence (switch with random delay)", "value": 1 }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "RandomMinutes",
                            "caption": "Random delay up to",
                            "suffix": "min",
                            "minimum": 0,
                            "maximum": 120
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "MinOnMinutes",
                    "caption": "Minimum on-time before switching off because of absence or brightness",
                    "suffix": "min",
                    "minimum": 0,
                    "maximum": 480
                },
                {
                    "type": "CheckBox",
                    "name": "Enforce",
                    "caption": "Enforce the target on every check (switches manually changed lights back)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Notification",
            "expanded": false,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "NotifyUnconfirmed",
                    "caption": "Notify when a light does not confirm the switching"
                },
                {
                    "type": "CheckBox",
                    "name": "NotifySensor",
                    "caption": "Notify when the brightness sensor fails"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectInstance",
                            "name": "NotifyTarget",
                            "caption": "Visualization (empty = first one found)",
                            "width": "400px"
                        },
                        {
                            "type": "Button",
                            "caption": "Send test message",
                            "onClick": "IPS_RequestAction($id, 'TestNotify', 0);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile",
            "expanded": false,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "UseTile",
                    "caption": "Use own tile in the tile visualization"
                },
                {
                    "type": "Select",
                    "name": "TileTheme",
                    "caption": "Colour scheme of the tile",
                    "options": [
                        { "caption": "Symcon design (colours of the visualization)", "value": 0 },
                        { "caption": "Dark", "value": 1 },
                        { "caption": "Light", "value": 2 }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Take over from the previous script",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Reads sensors, lights, times, limits and the last switching state from your previous script. The script is only read, never executed. Times, limits and switches are written to the instance variables immediately; sensors and lights are saved with \"Apply changes\"."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectScript",
                            "name": "ImportScriptID",
                            "caption": "Previous script",
                            "width": "400px"
                        },
                        {
                            "type": "Button",
                            "caption": "Take over settings",
                            "onClick": "IPS_RequestAction($id, 'ImportScript', $ImportScriptID);"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Evaluate now",
            "onClick": "DEKO_Evaluate($id);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "All lights on",
                    "onClick": "DEKO_SetLights($id, true);"
                },
                {
                    "type": "Button",
                    "caption": "All lights off",
                    "onClick": "DEKO_SetLights($id, false);"
                }
            ]
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Active" },
        { "code": 104, "icon": "inactive", "caption": "Instance is inactive" },
        { "code": 200, "icon": "error", "caption": "Please add the lights" },
        { "code": 201, "icon": "error", "caption": "A light is missing or has no action" },
        { "code": 202, "icon": "error", "caption": "A sensor variable does not exist" },
        { "code": 203, "icon": "error", "caption": "No trigger: select a brightness sensor or use the sunset" },
        { "code": 204, "icon": "error", "caption": "A switch-off time in the light list is invalid (HH:MM)" },
        { "code": 205, "icon": "error", "caption": "Morning window: start must be before end" },
        { "code": 206, "icon": "error", "caption": "Season: invalid date" }
    ]
}
